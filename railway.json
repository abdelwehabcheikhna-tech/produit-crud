{
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "mvn clean compile assembly:single"
  },
  "deploy": {
    "startCommand": "mvn spring-boot:run -Dspring-boot.run.profiles=prod",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "numReplicas": 1,
    "sleepApplication": false
  }
}
